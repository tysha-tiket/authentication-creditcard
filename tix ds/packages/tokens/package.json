{
  "name": "@tiket-ds/tokens",
  "version": "0.1.0",
  "description": "Design tokens extracted from the Passport Tiket Design System Figma file.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
